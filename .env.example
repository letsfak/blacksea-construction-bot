# Construction Site Telegram Bot — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to git.

# ═══════════════════════════════════════════════════════════════
# TELEGRAM BOT
# ═══════════════════════════════════════════════════════════════

# Telegram Bot Token — get from @BotFather on Telegram
# Format: 1234567890:ABCDEFabcdefABCDEF-1234567890abcdef
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Optional: Telegram bot username (used in invite links)
# Example: my_construction_bot
BOT_USERNAME=your_bot_username

# Admin chat ID — receives onboarding + invite notifications
# Get yours: send a message to your bot, then visit
# https://api.telegram.org/bot<TELEGRAM_TOKEN>/getUpdates
ADMIN_CHAT_ID=YOUR_ADMIN_CHAT_ID

# Default firma (company) slug for multi-tenant mode
# Used by auth.js, compat.js, firestore_helpers.js as the fallback firma_id
# when a user has no firma assignment yet. Lowercase, no spaces.
DEFAULT_FIRMA_ID=your-company-slug

# ═══════════════════════════════════════════════════════════════
# FIREBASE (Firestore database)
# ═══════════════════════════════════════════════════════════════

# Firebase service account JSON — stringified (used on Render.com / server environments)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Then stringify it: node -e "console.log(JSON.stringify(require('./service-account.json')))"
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@YOUR_PROJECT_ID.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ═══════════════════════════════════════════════════════════════
# OPENAI (AI assistant feature)
# ═══════════════════════════════════════════════════════════════

# OpenAI API key — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY

# ═══════════════════════════════════════════════════════════════
# DROPBOX (Photo/document storage)
# ═══════════════════════════════════════════════════════════════

# Dropbox App Key — from https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=YOUR_DROPBOX_APP_KEY

# Dropbox App Secret
DROPBOX_APP_SECRET=YOUR_DROPBOX_APP_SECRET

# Dropbox Refresh Token — obtained via OAuth2 flow
# See: https://developers.dropbox.com/oauth-guide
DROPBOX_REFRESH_TOKEN=YOUR_DROPBOX_REFRESH_TOKEN

# ═══════════════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════════════

# Port (auto-injected by Render.com, default 3000 for local)
PORT=3000

# Render external URL — used for self-ping keepalive (prevents free-tier sleep)
# Example: https://your-service-name.onrender.com
RENDER_EXTERNAL_URL=https://your-service-name.onrender.com

# Node environment
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════
# OPTIONAL: Migration script
# ═══════════════════════════════════════════════════════════════

# Set to 'false' to actually run migration (default: dry run)
DRY_RUN=true
